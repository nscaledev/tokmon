{
  "name": "tokmon",
  "version": "0.32.2",
  "description": "Terminal + web dashboard for Claude Code, Codex, Cursor, Grok, opencode, pi, Copilot, Gemini & more — usage, limits, and costs",
  "type": "module",
  "bin": {
    "tokmon": "dist/cli.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "site/public/fonts/OFL.txt"
  ],
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:web",
    "build:cli": "tsup",
    "build:web": "pnpm --prefix web run build",
    "build:desktop": "pnpm --filter @tokmon/desktop run build",
    "build:site": "pnpm --prefix site run build",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-tests.mjs",
    "test:all": "node test/run-tests.mjs --all",
    "check": "pnpm run typecheck && pnpm run test && pnpm --prefix web run check",
    "check:full": "pnpm run typecheck && pnpm run test:all && pnpm --prefix web run check",
    "check:desktop": "pnpm --filter @tokmon/desktop run check",
    "check:site": "pnpm --prefix site run check && pnpm --prefix site run test",
    "web:install": "pnpm --prefix web install",
    "dev": "node scripts/dev-runner.mjs dev",
    "dev:web": "node scripts/dev-runner.mjs dev:web",
    "dev:desktop": "node scripts/dev-runner.mjs dev:desktop",
    "dev:installed": "node scripts/dev-runner.mjs dev:installed",
    "dev:site": "pnpm --prefix site run dev"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "@zenobius/ink-mouse": "^1.0.3",
    "effect": "4.0.0-beta.102",
    "ink": "^5.0.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "18.3.31",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "David Ilie <david@davidilie.com> (https://davidilie.com)",
  "homepage": "https://github.com/DavidIlie/tokmon",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidIlie/tokmon.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "usage",
    "tokens",
    "cost",
    "rate-limits",
    "terminal",
    "dashboard",
    "cli"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.34.4"
}
